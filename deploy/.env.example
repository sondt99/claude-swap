# Do not fill this in by hand — run ./setup.sh instead.
#
# setup.sh derives every value below from the machine it runs on (uid, gid,
# home, timezone), generates a token, writes .env at mode 600, installs the
# host `cswap` shim, and brings the stack up. It is safe to re-run: an existing
# token and tick interval are preserved.
#
# This file documents the shape, for reference and for anyone who would rather
# write .env themselves:
#
#     cp .env.example .env && chmod 600 .env

# Identity the containers run as, so files written into the mounted home keep
# their host owner and 0600 mode. From: id -u / id -g
HOST_UID=1000
HOST_GID=1000

# Must be the host home directory, mounted at this identical path — every path
# claude-swap derives (Path.home(), $XDG_DATA_HOME/claude-swap, ~/.claude.json)
# has to resolve to the same file on the host. The interpreter and all
# dependencies live inside the image, so the mount carries data only.
HOST_HOME=/home/youruser

# Defaults to UTC if unset. setup.sh reads the system zone.
TZ=UTC

# Seconds between autoswitch evaluations. This, not autoswitch.intervalSeconds,
# is what sets the cadence in this deployment: `cswap auto --once` evaluates
# once and returns, so the interval belongs to the loop that drives it.
CSWAP_TICK_S=15

# Dashboard token. Generate a fresh one per machine:
#
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
#
# Only read when auth is on (CSWAP_WEB_NO_AUTH=0 in docker-compose.yml). It is
# pinned to a SameSite=Strict cookie after the first visit, so the URL with
# ?token= only ever needs to be opened once.
CSWAP_WEB_TOKEN=
