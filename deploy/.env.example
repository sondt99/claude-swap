# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   cp .env.example .env && chmod 600 .env

# Identity the containers run as, so files written into the mounted home keep
# their host owner and 0600 mode. Fill from: id -u / id -g
HOST_UID=1000
HOST_GID=1000

# Must be the host home directory, mounted at this identical path — every path
# claude-swap derives (Path.home(), $XDG_DATA_HOME/claude-swap, ~/.claude.json,
# and the venv itself) has to resolve to the same file the host CLI uses.
HOST_HOME=/home/youruser

TZ=Asia/Ho_Chi_Minh

# Dashboard token. Generate a fresh one per machine:
#
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
#
# Only read when auth is on (CSWAP_WEB_NO_AUTH=0 in docker-compose.yml). It is
# pinned to a SameSite=Strict cookie after the first visit, so the URL with
# ?token= only ever needs to be opened once.
CSWAP_WEB_TOKEN=

# Seconds between autoswitch evaluations. This, not
# autoswitch.intervalSeconds, is what sets the cadence in this deployment:
# `cswap auto --once` evaluates once and returns, so the interval belongs to
# the loop that drives it.
CSWAP_TICK_S=15
